# Copy to .env, run chmod 600 .env, and fill values locally.
# Never commit or paste the API key into chat.
DEMO_MODE=live
HOKIEFLOW_AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=

# Conservative free-tier guards (provider calls, not user questions).
# A normal tool-backed question uses two calls.
HOKIEFLOW_GEMINI_CALLS_PER_HOUR=30
HOKIEFLOW_GEMINI_CALLS_PER_DAY=200
HOKIEFLOW_AI_QUESTIONS_PER_IP_HOUR=10

# Leave disabled except while running scripts/gemini_agent_smoke.py.
HOKIEFLOW_LIVE_SMOKE=0
