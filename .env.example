# HokieFlow environment template.
#
#   cp .env.example .env
#   chmod 600 .env          # the loader refuses a file that group/other can read
#   # fill in the values, then: python3 app/server.py
#
# A real environment variable ALWAYS wins over this file, so a container or
# platform setting is never clobbered by a stray .env. Values are never logged.
# In a deployment (Vercel/Render/Fly/whatever) set the same names in the platform
# UI and skip this file entirely.
#
# Nothing in this file is required for the OFFLINE demo:
#   DEMO_MODE=cache python3 app/server.py     # zero network, zero provider calls


# ---------------------------------------------------------------------------
# 1. Core mode  (the only setting the offline demo needs)
# ---------------------------------------------------------------------------
# cache = replay the frozen fixtures/, no network at all (demo + tests)
# live  = read cache/ and refresh from upstream (default when unset)
DEMO_MODE=cache

# Optional: pin the replay clock to a specific instant instead of the bus
# snapshot's capture time. Useful for taking a screenshot at a known hour.
# DEMO_NOW=2026-09-19T11:22:29-04:00


# ---------------------------------------------------------------------------
# 2. HokieFlow AI  (optional; without it free text uses the bounded parser)
# ---------------------------------------------------------------------------
# Provider is selected by name. Only "gemini" has an adapter today; the core
# loop is provider-neutral, so another adapter needs no changes elsewhere.
HOKIEFLOW_AI_PROVIDER=gemini

# Server-side secret. Never commit it, never put it in ui/config.js, never paste
# it into a chat or a log. Required only for the live agent.
GEMINI_API_KEY=

# A model id enabled for that key. There is no hardcoded default on purpose.
# Verified live with: gemini-3.6-flash, gemini-3.1-flash-lite
GEMINI_MODEL=gemini-3.1-flash-lite

# Free-tier guards, enforced against a ledger in cache/ so restarting the server
# cannot hand out a fresh allowance while the account quota still drains.
# A normal tool-backed question costs 2 calls, a compositional one up to 3.
# Sized so the per-IP question cap below trips first, and Google's account
# quota stays the real ceiling.
HOKIEFLOW_GEMINI_CALLS_PER_HOUR=600
HOKIEFLOW_GEMINI_CALLS_PER_DAY=3000

# Per-client-IP cap on live AI questions (protects the shared key from one
# noisy client, e.g. when the server is bound with --lan).
# A venue shares ONE public IP, so treat this as a per-room limit: 10 answered
# a whole room for an hour and then returned client_rate_limit to everyone.
HOKIEFLOW_AI_QUESTIONS_PER_IP_HOUR=240

# Live verification scripts are opt-in and refuse to run otherwise.
HOKIEFLOW_LIVE_SMOKE=0
HOKIEFLOW_BATTERY_MAX_CALLS=24
# HOKIEFLOW_SMOKE_VERBOSE=1     # print the model's prose before grounding


# ---------------------------------------------------------------------------
# 3. Accounts  (optional; needs: pip install -r requirements.txt)
# ---------------------------------------------------------------------------
# Without the supabase + python-dotenv packages every /api/auth/* route answers
# a typed 503 and the rest of the app runs normally, so this section is safe to
# leave empty for the demo.
SUPABASE_URL=
SUPABASE_KEY=

# "production" makes the session/oauth cookies Secure (HTTPS-only).
APP_ENV=development

# Where Google OAuth sends the browser back to. The default is the local server.
# APP_URL=http://127.0.0.1:8321/api/auth/google/callback


# ---------------------------------------------------------------------------
# 4. Data locations  (only needed to point the app at other stores)
# ---------------------------------------------------------------------------
# fixtures/ is the frozen replay store and is committed. cache/ and data/ are
# runtime-only and gitignored. Override only if you keep them elsewhere.
# HOKIEDAY_CACHE=/absolute/path/to/cache
# HOKIEDAY_DATA=/absolute/path/to/data
# HOKIEDAY_FIXTURES=/absolute/path/to/fixtures


# ---------------------------------------------------------------------------
# 5. Optional live sources
# ---------------------------------------------------------------------------
# VT GIS live reads require a stated permission reference (the GIS team's terms).
# HOKIEDAY_GIS_PERMISSION_REF=
# Sample the live VT GIS endpoints instead of the offline fixtures.
# VTGIS_LIVE=0

# Databricks handoff scripts only (not used by the app).
# DATABRICKS_HOST=
# DATABRICKS_TOKEN=